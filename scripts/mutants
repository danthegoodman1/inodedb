# (layer, package, extra cargo test arguments). A layer runs once its crate exists.
LAYERS = [
    ("core unit tests", "inodedb-core", "crates/core", []),
    ("storage tests", "inodedb-storage", "crates/storage", []),
    ("SQLite tests", "inodedb-storage-sqlite", "crates/storage-sqlite", []),
    ("storage conformance", "inodedb-storage-conformance", "crates/storage-conformance", []),
    ("server tests", "inodedb-server", "crates/server", []),
    ("transport tests", "inodedb-transport", "crates/transport", []),
    ("client tests", "inodedb-client", "crates/client", []),
    ("CLI tests", "inodedb-cli", "crates/cli", []),
    ("API conformance", "inodedb-tests", "tests", []),
    ("sim tests", "inodedb-sim", "crates/sim", []),
]


def main():
    # SIGTERM unwinds like Ctrl-C, so each step's cleanup runs.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--seeds", type=int, default=300)
    parser.add_argument("--only", action="append", help="run only this mutant; repeatable")
    parser.add_argument("--check", action="store_true", help="only check that every mutant applies")
    parser.add_argument("--no-baseline", action="store_true",
                        help="skip checking that the unmutated code passes every layer")
    parser.add_argument("--rocksdb", action="store_true",
                        help="plant bugs in the RocksDB backend, testing against its suites")
    parser.add_argument("--fdb", action="store_true",
                        help="plant bugs in the FoundationDB backend, testing against a cluster")
    args = parser.parse_args()

    root = Path(__file__).resolve().parent.parent
    work = root / "target" / "mutants"
    copy = work / "src"
    target = work / "target"
    results = []
    backend = "fdb" if args.fdb else "rocksdb" if args.rocksdb else None
    mutants = {"fdb": FDB_MUTANTS, "rocksdb": ROCKSDB_MUTANTS, None: MUTANTS}[backend]
    if args.check:
        broken = 0
        for name, replacements in MUTANTS + ROCKSDB_MUTANTS + FDB_MUTANTS:
            if args.only and name not in args.only:
                continue
            for path, old, new in replacements:
                count = len(list(re.finditer(pattern(old), (root / path).read_text())))
                if count != 1:
                    print(f"{name}: {count} matches in {path}")
                    broken += 1
        sys.exit(1 if broken else 0)
    # A layer that fails without a mutant would claim to catch every one.
    if not args.no_baseline:
        print("== baseline", flush=True)
        fresh_copy(root, copy)
        outcome = catch(copy, target, args.seeds, backend)
        if outcome != "MISSED":
            sys.exit(f"the unmutated code fails: {outcome}")
    for name, replacements in mutants:
        if args.only and name not in args.only:
            continue
        print(f"== {name}", flush=True)
        fresh_copy(root, copy)
        for path, old, new in replacements:
            file = copy / path
            text = file.read_text()
            matches = list(re.finditer(pattern(old), text))
            if len(matches) != 1:
                sys.exit(f"{name}: expected one match in {path}, found {len(matches)}, for:\n{old}")
            match = matches[0]
            file.write_text(text[: match.start()] + new + text[match.end() :])
        outcome = catch(copy, target, args.seeds, backend)
        print(outcome, flush=True)
        results.append((name, outcome))

    print()
    width = max((len(name) for name, _ in results), default=0)
    for name, outcome in results:
        print(f"{name:<{width}}  {outcome}")
    caught = sum(1 for _, outcome in results if outcome.startswith("caught"))
    print(f"{caught} of {len(results)} caught")
    if any(outcome in ("MISSED", "did not build") for _, outcome in results):
        sys.exit(1)


def fresh_copy(root, copy):
    """Copies the tree to `copy`. Fresh modification times make cargo
    rebuild every workspace crate, so no crate keeps an earlier build."""
    if copy.exists():
        shutil.rmtree(copy)
    shutil.copytree(root, copy, ignore=shutil.ignore_patterns("target", ".git"),
                    copy_function=shutil.copy)


def pattern(old):
    """A regex for `old` that ignores whitespace."""
    return r"\s*".join(re.escape(char) for char in old if not char.isspace())


def catch(copy, target, seeds, backend=None):
    """Which layer catches the mutant, or MISSED."""
    env = {"CARGO_TARGET_DIR": str(target)}
    if backend:
        return catch_on_backend(copy, env, backend)
    build = run(copy, env, ["cargo", "build", "-q", "--release", "--workspace", "--tests", "--bins"])
    if build is None or build.returncode != 0:
        print(build.stderr[-2000:] if build else "build timed out")
        return "did not build"
    metadata = run(copy, env, ["cargo", "metadata", "-q", "--format-version", "1", "--no-deps"])
    if metadata is None or metadata.returncode != 0:
        return "did not build"
    members = {package["name"] for package in json.loads(metadata.stdout)["packages"]}
    layers = [
        (layer, ["cargo", "test", "-q", "--release", "-p", package, *extra])
        for layer, package, directory, extra in LAYERS
        if package in members
    ]
    layers.append(("seeds", ["cargo", "run", "-q", "--release", "-p", "inodedb-sim", "--", "0",
                             "--seeds", str(seeds)]))
    for layer, command in layers:
        result = run(copy, env, command)
        if result is None:
            return f"caught by {layer} (hung)"
        if result.returncode != 0:
            if os.environ.get("MUTANTS_VERBOSE"):
                print(result.stdout[-3000:], result.stderr[-3000:])
            summary = next((line for line in result.stdout.splitlines() if " seeds from " in line), "")
            return f"caught by {layer}" + (f" ({summary})" if summary else "")
    return "MISSED"


def catch_on_backend(copy, env, backend):
    """Which of a backend's suites catches the mutant, or MISSED."""
    features = ["--features", backend, "--test", backend]
    suites = [("storage conformance", ["-p", "inodedb-storage-conformance", *features]),
              ("API conformance", ["-p", "inodedb-tests", *features])]
    if backend == "rocksdb":
        suites.append(("unit tests", ["-p", "inodedb-storage-rocksdb", "--lib"]))
    for layer, selection in suites:
        result = run(copy, env, ["cargo", "test", "-q", "--release", *selection])
        if result is None:
            return f"caught by {backend} {layer} (hung)"
        if result.returncode != 0:
            if "error: could not compile" in result.stderr:
                print(result.stderr[-2000:])
                return "did not build"
            return f"caught by {backend} {layer}"
    return "MISSED"


def run(cwd, env, command):
    """The finished process, or None if it ran past the step timeout. The
    step runs in its own process group, which is killed however the step
    ends, so a hung test binary never outlives it."""
    process = subprocess.Popen(command, cwd=cwd, env={**os.environ, **env},
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                               start_new_session=True)
    try:
        stdout, stderr = process.communicate(timeout=STEP_TIMEOUT)
        return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)
    except subprocess.TimeoutExpired:
        return None
    finally:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


if __name__ == "__main__":
    main()
